# ---- FreelanceScope Backend Environment Variables ----
# Copy this file to ".env" and fill in real values before running.

# Port the Express server listens on
# Render sets PORT automatically; use 5000 locally
PORT=5000

# MongoDB connection string
# LOCAL:   mongodb://127.0.0.1:27017/freelancescope
# ATLAS:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/freelancescope?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/freelancescope

# Secret used to sign JWT tokens
# Generate a strong one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret_string

# Frontend URL(s) allowed by CORS
# LOCAL:      http://localhost:5173
# PRODUCTION: https://freelancescope-ui.onrender.com
# MULTIPLE:   https://freelancescope-ui.onrender.com,https://yourcustomdomain.com
CLIENT_URL=http://localhost:5173

# Environment
NODE_ENV=development
